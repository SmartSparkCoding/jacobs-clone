[Unit]
Description=Jacob's Clone - Slack auto-responder
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/jacobs-clone
EnvironmentFile=/opt/jacobs-clone/.env
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
