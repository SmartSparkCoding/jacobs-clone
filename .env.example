# --- Slack app tokens (get these from api.slack.com/apps -> your app) ---
# Bot token, starts with xoxb-
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx

# App-level token (for Socket Mode), starts with xapp-1-
SLACK_APP_TOKEN=xapp-1-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# User OAuth token (the one that lets us post AS you), starts with xoxp-
SLACK_USER_TOKEN=xoxp-xxxxxxxxxxxx-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The Slack user ID (U...) of the person who installs the app.
# Only this user can use the app. Look it up here: https://api.slack.com/methods/auth.test
SLACK_USER_ID=U0XXXXXXXXX

# --- Optional ---
# Where auto-responder config + pending replies are stored
DATA_DIR=/opt/jacobs-clone/data
